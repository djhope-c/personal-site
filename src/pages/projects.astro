---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Projects">
	<ul class="links">
		<li><a href="/cookbook">Datacenter Cookbook</a></li>
	</ul>

	<style>
		.links {
			list-style: none;
			padding: 0;
			margin: 0;
			font-size: 1.3rem;
		}

		.links a {
			text-decoration: none;
			border-bottom: 1px solid transparent;
			transition: border-color 0.15s ease;
		}

		.links a:hover {
			border-color: var(--fg);
		}
	</style>
</Layout>
