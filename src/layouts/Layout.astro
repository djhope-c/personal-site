---
interface Props {
	title: string;
}

const { title } = Astro.props;
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body>
		<header>
			<nav>
				<a href="/">home</a>
				<a href="/books">books</a>
				<a href="/projects">projects</a>
			</nav>
		</header>
		<main>
			<slot />
		</main>

		<style is:global>
			:root {
				--fg: #1a1a1a;
				--bg: #fdfdfc;
				--muted: #767672;
				color-scheme: light dark;
			}

			@media (prefers-color-scheme: dark) {
				:root {
					--fg: #eeeeec;
					--bg: #141414;
					--muted: #8a8a86;
				}
			}

			* {
				box-sizing: border-box;
			}

			html,
			body {
				margin: 0;
				padding: 0;
			}

			body {
				background: var(--bg);
				color: var(--fg);
				font-family:
					-apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial,
					sans-serif;
				line-height: 1.5;
				min-height: 100vh;
			}

			a {
				color: inherit;
			}

			header {
				padding: 2rem clamp(1.5rem, 5vw, 4rem) 0;
			}

			nav {
				display: flex;
				gap: 1.5rem;
				font-size: 0.95rem;
			}

			nav a {
				text-decoration: none;
				color: var(--muted);
				transition: color 0.15s ease;
			}

			nav a:hover {
				color: var(--fg);
			}

			main {
				padding: clamp(2rem, 8vh, 6rem) clamp(1.5rem, 5vw, 4rem);
				max-width: 900px;
				margin: 0 auto;
			}
		</style>
	</body>
</html>
